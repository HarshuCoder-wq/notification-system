# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# DATABASE_URL=postgres://...   (leave empty locally -> SQLite)

# Admin user (created by `python manage.py ensure_admin`)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
ADMIN_EMAIL=your_email@gmail.com
ADMIN_PHONE=919XXXXXXXXX

# WhatsApp Cloud API (Meta sandbox)
WHATSAPP_ACCESS_TOKEN=your_test_token
PHONE_NUMBER_ID=your_test_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
WHATSAPP_API_VERSION=v25.0

# Email (Brevo free tier)
BREVO_API_KEY=xkeysib-...
BREVO_FROM_EMAIL=your_verified_email@gmail.com
BREVO_FROM_NAME=NotifyHub

# Web Push (OneSignal)
ONESIGNAL_APP_ID=your_app_id
ONESIGNAL_REST_API_KEY=your_rest_api_key

# Hourly inactivity job secret (same value in GitHub Actions secret)
CRON_SECRET=some-long-random-string
